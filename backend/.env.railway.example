# Ejemplo de VARIABLES para el servicio Backend de Railway (NO es un archivo para publicar con secretos).
# Crea el servicio de base de datos llamado exactamente MySQL.
SPRING_PROFILES_ACTIVE=railway
DB_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?connectionTimeZone=UTC
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
APP_DEMO_DATA_ENABLED=false
# Anade esta variable despues de generar el dominio HTTPS del servicio Frontend:
APP_CORS_ALLOWED_ORIGINS=https://${{Frontend.RAILWAY_PUBLIC_DOMAIN}}
# Para 1 GB de RAM; adapta si usas otro plan
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0 -Duser.timezone=America/Lima
