# Ejemplo para el perfil azure. Nunca subas tu .env con secretos.
SPRING_PROFILES_ACTIVE=azure
DB_URL=jdbc:mysql://mi-servidor.mysql.database.azure.com:3306/biblioteca_don_quijote?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=usuario_mysql
DB_PASSWORD=REEMPLAZA_CON_TU_CONTRASENA
APP_CORS_ALLOWED_ORIGINS=https://tu-frontend.azurestaticapps.net
APP_DEMO_DATA_ENABLED=false
# Configura JAVA_TOOL_OPTIONS=-Duser.timezone=America/Lima en Azure
